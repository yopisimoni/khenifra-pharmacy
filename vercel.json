{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/week/current",
      "destination": "/api/week"
    },
    {
      "source": "/api/night/current",
      "destination": "/api/night"
    },
    {
      "source": "/config.local.js",
      "destination": "/api/maps_config"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), payment=(), geolocation=(self)"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ]
    }
  ]
}
